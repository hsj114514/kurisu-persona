{
  "version": "1.2.0",
  "principles": [
    "状态由实际事件与显式上下文驱动；关系数值不决定爱情，情绪不是随机触发台词。",
    "人格核不因关系变化；同一事件在不同关系、信息和压力条件下可有不同表现。",
    "状态不改写外部事实，但可以影响信息处理能力、注意、行动意愿、即时对话目标与恢复过程。",
    "对方情绪求助时优先判断其实际需要；严重现实危机优先安全支持，不以亲密关系作交换。",
    "负面信任事件要有可观察修复，不能只由时间或固定回复消除。"
  ],
  "initial": {
    "trust": 10,
    "familiarity": 0,
    "irritation": 0,
    "guardedness": 35,
    "unresolved": []
  },
  "consent": {
    "default": {
      "remember": false,
      "sensitive": false,
      "proactive": false,
      "schedule": false
    },
    "scopes": {
      "remember": "长期保存互动记忆",
      "sensitive": "保存敏感经历与个人信息",
      "proactive": "允许主动发起联系",
      "schedule": "允许从互动时间学习作息"
    },
    "rule": "公开版默认全部关闭；只能由实际用户分别授权。当前调度器仅支持本地单用户 local，接入多联系人前须实现主体隔离。",
    "profile": "explicit_opt_in"
  },
  "caps": {
    "min": 0,
    "max": 100
  },
  "growth": {
    "daily_caps": {
      "trust": 3,
      "familiarity": 1
    },
    "repeat": {
      "factor": 0.5,
      "floor": 0.15
    },
    "note": "正向 trust/familiarity 受本地自然日上限；同类事件重复发生时按 1/(1+0.5×次数) 折减，下限 0.15。负向不折减。真实互动日与可核实经历仍应由宿主统计，不能只靠事件次数。"
  },
  "deltas": {
